[Unit]
Description=Nimbus Validator Client ({{ testnet_network }})
Wants=network-online.target consensus.service
After=network-online.target consensus.service
Documentation=https://nimbus.guide/

[Service]
Type=simple
User=validator
Group=validator
Restart=always
RestartSec=3

# KMS-encrypted key management
ExecStartPre=/usr/local/bin/decrypt-validator-keys.sh
ExecStopPost=/usr/local/bin/cleanup-validator-keys.sh

ExecStart={{ nimbus_validator_bin }} \
  --data-dir={{ nimbus_validator_data_dir }} \
  --validators-dir=/run/validator-keys \
  --secrets-dir=/run/validator-keys \
  --beacon-node=http://127.0.0.1:{{ nimbus_rest_port }} \
  --metrics \
  --metrics-port={{ validator_metrics_port }} \
  --metrics-address=127.0.0.1 \
  --suggested-fee-recipient={{ fee_recipient_address }} \
  --graffiti="{{ validator_graffiti }}" \
  --log-level=INFO

# Resource limits
LimitNOFILE=8192

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
